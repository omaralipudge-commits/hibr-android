<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2B5A4C</item>
        <item name="android:navigationBarColor">#F7F8F4</item>
        <item name="android:statusBarColor">#F7F8F4</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AlarmTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
        <item name="android:colorAccent">#2B5A4C</item>
    </style>
</resources>
